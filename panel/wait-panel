#!/usr/bin/env bash
# wait-panel: block until both reviewer jobs for a panel finish, then validate.
#
# Usage:
#   wait-panel <panel-id>
#
# Reads $HOME/.orchestra/panels/<panel-id>/manifest.json and polls (every 2s)
# for every reviewer job's exit_code file. Validates each reviewer:
#   - exit_code is 0
#   - final.md exists and size > 0
#   - final.md contains a severity header OR the "No findings." sentinel
#
# Prints one stderr line per state change while waiting and a final summary
# table to stdout. On success (exit 0), also prints a "reviews ready — …" block
# with one "<reviewer> <path-to-final.md>" line per reviewer, then a
# "next baseline: tree:<hash>" line (the manifest's reviewed_tree — copy it
# into the next round's --scope). Exits:
#   0 — both reviewer jobs passed validation
#   1 — at least one reviewer failed (non-zero exit, empty final.md, or invalid)
#   2 — bad usage / missing manifest

set -euo pipefail

PANEL_ID="${1:-}"
[[ -n "$PANEL_ID" ]] || { echo "wait-panel: usage: wait-panel <panel-id>" >&2; exit 2; }

PANEL_DIR="$HOME/.orchestra/panels/$PANEL_ID"
MANIFEST="$PANEL_DIR/manifest.json"
[[ -f "$MANIFEST" ]] || { echo "wait-panel: manifest not found at $MANIFEST" >&2; exit 2; }
command -v jq      >/dev/null || { echo "wait-panel: jq not installed" >&2; exit 2; }

REVIEWERS=(claude codex)

count_done() {
  local n=0
  for reviewer in "${REVIEWERS[@]}"; do
    local jid runner
    jid=$(jq -r ".reviewers.$reviewer.job_id" "$MANIFEST")
    runner=$(jq -r ".reviewers.$reviewer.runner" "$MANIFEST")
    [[ -f "$HOME/.orchestra/jobs/$runner/$jid/exit_code" ]] && n=$((n+1))
  done
  echo "$n"
}

# Poll every 2s, logging only on state change so stderr stays compact
# (~7 lines total regardless of total wait time).
LAST=-1
while :; do
  DONE=$(count_done)
  if [[ "$DONE" != "$LAST" ]]; then
    echo "wait-panel: $DONE/2 done" >&2
    LAST=$DONE
  fi
  [[ "$DONE" -ge 2 ]] && break
  sleep 2
done

# Validate.
FAIL=0
FINAL_PATHS=()
printf "%-22s %-7s %-12s %-12s %s\n" "reviewer" "exit" "final.md" "verdict" "notes"
for reviewer in "${REVIEWERS[@]}"; do
  jid=$(jq -r ".reviewers.$reviewer.job_id" "$MANIFEST")
  runner=$(jq -r ".reviewers.$reviewer.runner" "$MANIFEST")
  dir="$HOME/.orchestra/jobs/$runner/$jid"
  FINAL_PATHS+=("$reviewer $dir/final.md")
  ec=$(cat "$dir/exit_code" 2>/dev/null || echo "?")
  size=$(wc -c < "$dir/final.md" 2>/dev/null || echo 0)
  size=$(echo "$size" | tr -d ' ')

  verdict="ok"
  note=""
  if [[ "$ec" != "0" ]]; then
    verdict="FAIL"; note="non-zero exit; see $dir/stderr.log"; FAIL=1
  elif [[ "$size" -eq 0 ]]; then
    verdict="FAIL"; note="empty final.md"; FAIL=1
  elif ! grep -qE '^## (Critical|High|Medium|Low)|No findings\.' "$dir/final.md"; then
    verdict="FAIL"; note="missing severity header or 'No findings.'"; FAIL=1
  fi
  printf "%-22s %-7s %-12s %-12s %s\n" "$reviewer" "$ec" "${size}B" "$verdict" "$note"
done

if [[ "$FAIL" -eq 0 ]]; then
  echo ""
  echo "reviews ready — read each with the Read tool:"
  for entry in "${FINAL_PATHS[@]}"; do
    echo "  $entry"
  done
  REVIEWED_TREE=$(jq -r '.reviewed_tree // empty' "$MANIFEST")
  if [[ -n "$REVIEWED_TREE" ]]; then
    echo "next baseline: tree:$REVIEWED_TREE"
  fi
fi

exit "$FAIL"
