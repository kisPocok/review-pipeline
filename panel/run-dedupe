#!/usr/bin/env bash
# run-dedupe: assemble the 6 lens reports, fire the Opus xhigh deduper, wait.
#
# Usage:
#   run-dedupe <panel-id>
#
# Reads $HOME/.orchestra/panels/<panel-id>/manifest.json, concatenates each
# lens's final.md into a single input, prepends the deduper prompt, and fires
# claude-job (--tier strongest --mode research) with the JSON
# schema. Waits for completion, then prints the path to the deduper's final.md
# (which contains the structured findings JSON).
#
# Exits:
#   0 — deduper completed with exit 0 and non-empty final.md
#   1 — deduper failed (non-zero exit) or produced empty final.md
#   2 — bad usage / missing manifest / missing lens output

set -euo pipefail

PANEL_ID="${1:-}"
[[ -n "$PANEL_ID" ]] || { echo "run-dedupe: usage: run-dedupe <panel-id>" >&2; exit 2; }

PANEL_DIR="$HOME/.orchestra/panels/$PANEL_ID"
MANIFEST="$PANEL_DIR/manifest.json"
[[ -f "$MANIFEST" ]] || { echo "run-dedupe: manifest not found at $MANIFEST" >&2; exit 2; }

SCRIPT_DIR=$(cd "$(dirname "$0")" && pwd)
SKILL_ROOT=$(cd "$SCRIPT_DIR/.." && pwd)
DEDUPER_PROMPT="$SKILL_ROOT/triage/deduper-prompt.md"
DEDUPER_SCHEMA="$SKILL_ROOT/triage/deduper-schema.json"
CLAUDE_JOB="$SKILL_ROOT/jobs/claude-job"
REPO_ROOT=$(jq -r '.repo_root' "$MANIFEST")

[[ -f "$DEDUPER_PROMPT" ]] || { echo "run-dedupe: missing $DEDUPER_PROMPT" >&2; exit 2; }
[[ -f "$DEDUPER_SCHEMA" ]] || { echo "run-dedupe: missing $DEDUPER_SCHEMA" >&2; exit 2; }
[[ -x "$CLAUDE_JOB"     ]] || { echo "run-dedupe: missing $CLAUDE_JOB" >&2; exit 2; }
[[ -d "$REPO_ROOT"      ]] || { echo "run-dedupe: repo_root '$REPO_ROOT' from manifest is not a directory" >&2; exit 2; }

# Per-panel scratch dir avoids the macOS-mktemp "XXXXXX must be at end" pitfall
# and collisions between concurrent panels.
SCRATCH="$PANEL_DIR/dedupe"
mkdir -p "$SCRATCH"
INPUT="$SCRATCH/input.md"
PROMPT="$SCRATCH/prompt.md"
: > "$INPUT"

for lens in security architecture quality security_xcheck frontend test_effectiveness; do
  jid=$(jq -r ".lenses.$lens.job_id" "$MANIFEST")
  runner=$(jq -r ".lenses.$lens.runner" "$MANIFEST")
  final="$HOME/.orchestra/jobs/$runner/$jid/final.md"
  [[ -s "$final" ]] || { echo "run-dedupe: lens '$lens' final.md missing or empty at $final" >&2; exit 2; }
  {
    echo "## Lens report: $lens"
    echo
    cat "$final"
    echo
  } >> "$INPUT"
done

cat "$DEDUPER_PROMPT" "$INPUT" > "$PROMPT"

DEDUPE_JOB=$("$CLAUDE_JOB" \
  --tier strongest \
  --mode research \
  --name "${PANEL_ID}-dedupe" \
  --repo-root "$REPO_ROOT" \
  --prompt-file "$PROMPT" \
  --json-schema "$DEDUPER_SCHEMA")

JDIR="$HOME/.orchestra/jobs/claude/$DEDUPE_JOB"
echo "run-dedupe: fired $DEDUPE_JOB" >&2
echo "run-dedupe: waiting for $JDIR/exit_code" >&2

while [[ ! -f "$JDIR/exit_code" ]]; do
  sleep 2
done

EC=$(cat "$JDIR/exit_code")
FINAL="$JDIR/final.md"
SIZE=$(wc -c < "$FINAL" 2>/dev/null | tr -d ' ' || echo 0)

if [[ "$EC" != "0" ]]; then
  echo "run-dedupe: deduper exited $EC; see $JDIR/stderr.log" >&2
  exit 1
fi
if [[ "$SIZE" -eq 0 ]]; then
  echo "run-dedupe: deduper produced empty final.md (silent failure)" >&2
  exit 1
fi

# Print only the findings path to stdout; status to stderr.
echo "$FINAL"
echo "run-dedupe: done; findings JSON at $FINAL (${SIZE}B)" >&2
