#!/usr/bin/env bash
# review-panel: fire two reviewers in parallel against a repo.
#
# Usage:
#   review-panel --repo-root <path> \
#                [--scope staged|branch:<base>|tree:<hash>] \
#                [--packet <path-to-shared-context-md>] \
#                [--name SHORT] \
#                [--cycle <cycle-id>]
#
# Cycle:
#   Omit --cycle on round 1 — a cycle-id is generated and a per-cycle record is
#   created at $HOME/.orchestra/cycles/<cycle-id>.json. Pass --cycle <id> on
#   round 2+ to append that round to the same record. wait-panel surfaces the
#   cycle-id (and the next baseline) on success.
#
# Scopes:
#   staged       — git diff --cached (the default; round 1 of a review cycle).
#   branch:BASE  — git diff BASE...HEAD (review a whole branch).
#   tree:HASH    — git diff HASH <current-write-tree> (round 2+ — review only
#                  the fix delta against a frozen baseline tree).
#
# Builds one reviewer prompt (fixed preamble + shared packet + scoped diff) and
# fires one claude-job + one codex-job in parallel, writing a manifest at
# $HOME/.orchestra/panels/<panel-id>/manifest.json.
#
# Prints the panel-id on stdout. Poll the manifest by checking each job's
# exit_code file under ~/.orchestra/jobs/{codex,claude}/<job-id>/.

set -euo pipefail

REPO_ROOT=""
SCOPE="staged"
PACKET=""
NAME="panel"
CYCLE_ID=""
CYCLE_PROVIDED=0

while [[ $# -gt 0 ]]; do
  case "$1" in
    --repo-root)   REPO_ROOT="$2"; shift 2 ;;
    --scope)       SCOPE="$2"; shift 2 ;;
    --packet)      PACKET="$2"; shift 2 ;;
    --name)        NAME="$2"; shift 2 ;;
    --cycle)       CYCLE_ID="$2"; CYCLE_PROVIDED=1; shift 2 ;;
    -h|--help)     sed -n '2,15p' "$0"; exit 0 ;;
    *) echo "review-panel: unknown flag: $1" >&2; exit 2 ;;
  esac
done

[[ -d "$REPO_ROOT" ]] || { echo "review-panel: --repo-root must be a directory" >&2; exit 2; }

CYCLES_DIR="$HOME/.orchestra/cycles"

# A --cycle id reaches a filesystem path and the manifest JSON; constrain it so a
# stray '/' or '..' cannot escape the cycles dir or break the manifest. A provided
# id with no record means a stale/typoed id — recording it as a fresh round 1 would
# desync the recovery flow, so reject both before firing the reviewers.
if [[ "$CYCLE_PROVIDED" -eq 1 ]]; then
  [[ "$CYCLE_ID" =~ ^[A-Za-z0-9._-]+$ ]] || {
    echo "review-panel: --cycle id must match [A-Za-z0-9._-]+" >&2; exit 2; }
  [[ -f "$CYCLES_DIR/$CYCLE_ID.json" ]] || {
    echo "review-panel: --cycle $CYCLE_ID has no record at $CYCLES_DIR/$CYCLE_ID.json" >&2; exit 2; }
fi

SCRIPT_DIR=$(cd "$(dirname "$0")" && pwd)
SKILL_ROOT=$(cd "$SCRIPT_DIR/.." && pwd)
JOBS_DIR="$SKILL_ROOT/jobs"
CODEX_JOB="${REVIEW_PIPELINE_CODEX_JOB:-$JOBS_DIR/codex-job}"
CLAUDE_JOB="${REVIEW_PIPELINE_CLAUDE_JOB:-$JOBS_DIR/claude-job}"
PREAMBLE="$SKILL_ROOT/panel/reviewer-preamble.md"

[[ -x "$CODEX_JOB"    ]] || { echo "review-panel: codex-job missing at $CODEX_JOB" >&2; exit 2; }
[[ -x "$CLAUDE_JOB"   ]] || { echo "review-panel: claude-job missing at $CLAUDE_JOB" >&2; exit 2; }
[[ -f "$PREAMBLE"     ]] || { echo "review-panel: reviewer-preamble.md missing at $PREAMBLE" >&2; exit 2; }
command -v jq >/dev/null || { echo "review-panel: jq not installed" >&2; exit 2; }

# Capture the diff once for all lenses.
case "$SCOPE" in
  staged)
    DIFF=$(git -C "$REPO_ROOT" diff --cached)
    DIFF_STAT=$(git -C "$REPO_ROOT" diff --stat --cached)
    SCOPE_LABEL="staged (uncommitted)"
    ;;
  branch:*)
    BASE="${SCOPE#branch:}"
    DIFF=$(git -C "$REPO_ROOT" diff "${BASE}...HEAD")
    DIFF_STAT=$(git -C "$REPO_ROOT" diff --stat "${BASE}...HEAD")
    SCOPE_LABEL="branch vs ${BASE}"
    ;;
  tree:*)
    BASE_TREE="${SCOPE#tree:}"
    CURRENT_TREE=$(git -C "$REPO_ROOT" write-tree)
    DIFF=$(git -C "$REPO_ROOT" diff "${BASE_TREE}" "${CURRENT_TREE}")
    DIFF_STAT=$(git -C "$REPO_ROOT" diff --stat "${BASE_TREE}" "${CURRENT_TREE}")
    SCOPE_LABEL="fix delta vs frozen tree ${BASE_TREE:0:12}"
    ;;
  *)
    echo "review-panel: unknown scope: $SCOPE (expected staged, branch:<base>, or tree:<hash>)" >&2
    exit 2
    ;;
esac

if [[ -z "$DIFF" ]]; then
  echo "review-panel: empty diff for scope=$SCOPE — nothing to review." >&2
  echo "" >&2
  echo "What to do:" >&2
  echo "  1. Stage your files:  git -C $REPO_ROOT add <files>" >&2
  echo "  2. Verify staging:    git -C $REPO_ROOT diff --cached --stat" >&2
  echo "  3. Refire the panel." >&2
  echo "" >&2
  echo "Common cause: 'git add && git commit' chained in one call." >&2
  echo "The PreToolUse hook blocks the entire command — git add never runs." >&2
  echo "Always run git add and git commit as separate Bash tool calls." >&2
  exit 2
fi

GIT_STATUS=$(git -C "$REPO_ROOT" status --short)

# The tree under review at fire time (pre-fix). Round N+1 uses it as its
# --scope tree: baseline; wait-panel surfaces it as the "next baseline" line.
REVIEWED_TREE="${CURRENT_TREE:-$(git -C "$REPO_ROOT" write-tree)}"

NAME=$(echo "$NAME" | tr -c '[:alnum:]-_' '-' | sed 's/-\+/-/g;s/^-//;s/-$//')
PANEL_ID="${NAME}-$(date +%Y%m%d-%H%M%S)-$$"
PANEL_DIR="$HOME/.orchestra/panels/$PANEL_ID"
mkdir -p "$PANEL_DIR"

# Persist the shared context block once so the reviewer prompt can include it.
SHARED_PACKET="$PANEL_DIR/packet.md"
if [[ -n "$PACKET" && -f "$PACKET" ]]; then
  cp "$PACKET" "$SHARED_PACKET"
else
  cat > "$SHARED_PACKET" <<EOF
## Context

_No reviewer packet was supplied. The lens has only the diff to work from._

EOF
fi

# Compose the shared review-packet header that prepends every lens prompt.
SHARED_HEADER="$PANEL_DIR/header.md"
{
  cat "$SHARED_PACKET"
  echo
  echo "## Scope"
  echo
  echo "$SCOPE_LABEL"
  echo
  echo "## Review packet"
  echo
  echo "\`git status --short\` output:"
  echo
  echo '```'
  printf '%s\n' "$GIT_STATUS"
  echo '```'
  echo
  echo "\`git diff --stat\` output:"
  echo
  echo '```'
  printf '%s\n' "$DIFF_STAT"
  echo '```'
  echo
  echo "Full diff:"
  echo
  echo '```diff'
  printf '%s\n' "$DIFF"
  echo '```'
  echo
} > "$SHARED_HEADER"

# Build one shared reviewer prompt: fixed preamble + packet/diff header.
PROMPT="$PANEL_DIR/prompt.md"
{
  cat "$PREAMBLE"
  echo
  echo "---"
  echo
  cat "$SHARED_HEADER"
} > "$PROMPT"

# Fire exactly two reviewers with the same prompt; diversity comes from the models.
CLAUDE_JOB_ID=$("$CLAUDE_JOB" \
  --tier strongest \
  --mode review \
  --name "${PANEL_ID}-claude" \
  --repo-root "$REPO_ROOT" \
  --prompt-file "$PROMPT")

# If this second launch fails, the claude job above is already burning a
# strongest-tier run with no manifest referencing it — terminate it, don't
# orphan it. The pid file holds the job's background subshell; pkill -P
# reaches the timeout/claude child underneath it.
if ! CODEX_JOB_ID=$("$CODEX_JOB" \
  --tier strongest \
  --mode review \
  --name "${PANEL_ID}-codex" \
  --repo-root "$REPO_ROOT" \
  --prompt-file "$PROMPT"); then
  echo "review-panel: codex-job launch failed — cancelling claude job $CLAUDE_JOB_ID" >&2
  CLAUDE_PID=$(cat "$HOME/.orchestra/jobs/claude/$CLAUDE_JOB_ID/pid" 2>/dev/null || true)
  if [[ -n "$CLAUDE_PID" ]]; then
    pkill -TERM -P "$CLAUDE_PID" 2>/dev/null || true
    kill -TERM "$CLAUDE_PID" 2>/dev/null || true
  fi
  exit 2
fi

NOW=$(date -Iseconds 2>/dev/null || date +%Y-%m-%dT%H:%M:%S%z)

# A new cycle (round 1) gets a generated id; round 2+ reuses the one passed in.
[[ -n "$CYCLE_ID" ]] || CYCLE_ID="cycle-${NAME}-$(date +%Y%m%d-%H%M%S)-$$"

cat > "$PANEL_DIR/manifest.json" <<EOF
{
  "panel_id": "$PANEL_ID",
  "cycle_id": "$CYCLE_ID",
  "scope": "$SCOPE",
  "scope_label": "$SCOPE_LABEL",
  "reviewed_tree": "$REVIEWED_TREE",
  "repo_root": "$REPO_ROOT",
  "started_at": "$NOW",
  "reviewers": {
    "claude": {"runner": "claude", "tier": "strongest", "job_id": "$CLAUDE_JOB_ID"},
    "codex":  {"runner": "codex",  "tier": "strongest", "job_id": "$CODEX_JOB_ID"}
  }
}
EOF

# Durable per-cycle record: lets a fresh agent (post-compaction) recover the
# panel-ids, baselines, and disposition paths for every round without holding
# them in working memory. Round 1 creates it; round 2+ appends.
mkdir -p "$CYCLES_DIR"
CYCLE_FILE="$CYCLES_DIR/$CYCLE_ID.json"
ROUND_ENTRY=$(jq -n \
  --arg panel_id "$PANEL_ID" \
  --arg scope "$SCOPE" \
  --arg scope_label "$SCOPE_LABEL" \
  --arg reviewed_tree "$REVIEWED_TREE" \
  --arg dispositions_path "$PANEL_DIR/dispositions.json" \
  --arg started_at "$NOW" \
  '{panel_id:$panel_id, scope:$scope, scope_label:$scope_label, reviewed_tree:$reviewed_tree, dispositions_path:$dispositions_path, started_at:$started_at}')

# Write through a same-dir temp + atomic rename so a crash mid-write cannot leave
# a truncated cycle file the recovery flow depends on, and a jq failure aborts
# instead of silently dropping the round.
CYCLE_TMP=$(mktemp "$CYCLES_DIR/.tmp.XXXXXX")
if [[ -f "$CYCLE_FILE" ]]; then
  CYCLE_WRITE=(jq --argjson round "$ROUND_ENTRY" --arg now "$NOW"
    '.rounds += [$round + {round: ((.rounds | length) + 1)}] | .updated_at = $now'
    "$CYCLE_FILE")
else
  CYCLE_WRITE=(jq -n
    --arg cycle_id "$CYCLE_ID" --arg repo_root "$REPO_ROOT" --arg now "$NOW"
    --argjson round "$ROUND_ENTRY"
    '{cycle_id:$cycle_id, repo_root:$repo_root, created_at:$now, updated_at:$now, rounds:[($round + {round:1})]}')
fi
if ! "${CYCLE_WRITE[@]}" > "$CYCLE_TMP"; then
  rm -f "$CYCLE_TMP"
  echo "review-panel: failed to write cycle record at $CYCLE_FILE" >&2; exit 2
fi
mv "$CYCLE_TMP" "$CYCLE_FILE"
echo "review-panel: cycle $CYCLE_ID — recorded round at $CYCLE_FILE" >&2

echo "$PANEL_ID"
